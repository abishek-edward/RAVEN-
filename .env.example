# ============================================================
# RAVEN Platform — Environment Variables Example
# Copy this file to .env and configure your secrets.
# NEVER commit real credentials to Git.
# ============================================================

# Express Server Port
PORT=3001

# Public Render API Base URL (for frontend production deployment, e.g. Vercel)
# VITE_API_BASE_URL=https://raven-c724.onrender.com

# Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://docjnqmiondffmziwvcm.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct PostgreSQL Connection String (Supabase Dashboard -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.docjnqmiondffmziwvcm.supabase.co:5432/postgres

# Anthropic Claude API Key (for server-side AI evaluations)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
